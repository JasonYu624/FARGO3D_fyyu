# modelB_3D.bound.1
# Fluid 1: dust
# Radial BCs = steady-state drift ICs; vertical density = 0 in ghost cells.

Density:
        Ymin: MODELBDUST3DDENSRAD
        Ymax: MODELBDUST3DDENSRAD
        Zmin: DUSTZERO
        Zmax: DUSTZERO

Vx:     # azimuthal velocity v_phi,d
        Ymin: MODELBDUST3DVPHIRAD
        Ymax: MODELBDUST3DVPHIRAD
        Zmin: MODELBDUST3DVPHICOL
        Zmax: MODELBDUST3DVPHICOL

Vy:     # radial velocity v_R,d
        Ymin: MODELBDUST3DVRRAD
        Ymax: MODELBDUST3DVRRAD
        Zmin: DUSTZEROV
        Zmax: DUSTZEROV

Vz:     # vertical velocity v_z,d = 0
        Ymin: MODELBDUST3DVZ
        Ymax: MODELBDUST3DVZ
        Zmin: DUSTZEROV
        Zmax: DUSTZEROV

